import {
  Connection,
  PublicKey,
  Transaction,
  sendAndConfirmTransaction,
  Keypair,
} from '@solana/web3.js';
import {
  TOKEN_PROGRAM_ID,
  getAssociatedTokenAddress,
  createAssociatedTokenAccountInstruction,
  getAccount,
  createTransferInstruction,
} from '@solana/spl-token';

async function transferTokenWithAuth() {
  // Initialize connection
  const connection = new Connection('https://api.mainnet-beta.solana.com', 'confirmed');

  // Define the known addresses
  const TOKEN_PROGRAM = new PublicKey('TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA');
  const SOURCE_ADDRESS = new PublicKey('2Ejhz55jr3GWPPkYpCHxYEGq2YUDEqpdNFDC1uuF12rE');
  const DESTINATION_ADDRESS = new PublicKey('5yyYSZYU4YNozhctX1RWYuRXMf9wmRmdnX81h8C8FpcV');
  const UPGRADE_AUTHORITY = new PublicKey('AxNc78iUR1k749SHu2ALMY5M5dJ9FrRwRngTgAuVR8Qb');

  try {
    console.log('Starting token transfer process...');

    // First, get the token accounts for both addresses
    const sourceTokenAccount = await getAssociatedTokenAddress(
      TOKEN_PROGRAM,
      SOURCE_ADDRESS,
      false
    );

    const destinationTokenAccount = await getAssociatedTokenAddress(
      TOKEN_PROGRAM,
      DESTINATION_ADDRESS,
      false
    );

    // Verify the source account exists and has the token
    const sourceAccount = await getAccount(connection, sourceTokenAccount);
    console.log('Source account balance:', sourceAccount.amount.toString());

    // Create transaction
    let transaction = new Transaction();

    // Check if destination token account exists, if not, create it
    try {
      await getAccount(connection, destinationTokenAccount);
    } catch (error) {
      console.log('Creating destination token account...');
      transaction.add(
        createAssociatedTokenAccountInstruction(
          UPGRADE_AUTHORITY,
          destinationTokenAccount,
          DESTINATION_ADDRESS,
          TOKEN_PROGRAM
        )
      );
    }

    // Add transfer instruction
    transaction.add(
      createTransferInstruction(
        sourceTokenAccount,
        destinationTokenAccount,
        SOURCE_ADDRESS,
        1,  // amount
        [UPGRADE_AUTHORITY],  // signers
        TOKEN_PROGRAM
      )
    );

    // Add verification data
    transaction.feePayer = UPGRADE_AUTHORITY;
    transaction.recentBlockhash = (await connection.getRecentBlockhash()).blockhash;

    console.log('Transaction created, awaiting signing and submission...');
    console.log('Source:', SOURCE_ADDRESS.toString());
    console.log('Destination:', DESTINATION_ADDRESS.toString());
    console.log('Authority:', UPGRADE_AUTHORITY.toString());

    // Note: The actual signing and sending would need the private key
    // This part would typically be handled by a wallet or signing service
    console.log(`
    Transaction is ready to be signed. Please sign with the upgrade authority.
    From: ${SOURCE_ADDRESS.toString()}
    To: ${DESTINATION_ADDRESS.toString()}
    Auth: ${UPGRADE_AUTHORITY.toString()}
    Program: ${TOKEN_PROGRAM.toString()}
    `);

    return {
      sourceAccount: sourceTokenAccount.toString(),
      destinationAccount: destinationTokenAccount.toString(),
      transaction: transaction.serialize().toString('base64')
    };

  } catch (error) {
    console.error('Error during token transfer setup:', error);
    throw error;
  }
}

// Export function for use
export { transferTokenWithAuth };